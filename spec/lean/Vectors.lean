import Stdx

/-!
# Vectors from the proved machines

Writes, or checks, every step of the machines `Stdx/Utf8` and `Stdx/Json/` prove, the
sequences `Stdx/Regex/Utf8` proves for ranges of scalar values, and the answers
`Stdx/Regex/MatcherAnswer` proves for searches of programs, into files beside the Zig code they
mirror.
A Zig unit test requires the Zig code to give the same, which is what ties the proofs about the
Lean definitions to the Zig code (decisions 28 and 86).

    lake exe vectors (--write | --check) <src directory>
    lake exe vectors --random <seed> <count>
    lake exe vectors --answers <dump file>
-/
open Stdx Stdx.Json

/-- The octets each machine takes a step on: every value of an octet. -/
def octets : List Nat := List.range 256

/-- One step of the UTF-8 machine: its state as `Utf8`'s fields, the octet, and the fields after
it, or `refused`. -/
def utf8Line (q : Utf8.State) (b : Nat) : String :=
  let (needed, low, high) := q.fields
  match Utf8.step q b with
  | some q' =>
    let (needed', low', high') := q'.fields
    s!"{needed} {low} {high} {b} {needed'} {low'} {high'}"
  | none => s!"{needed} {low} {high} {b} refused"

/-- Every step of the UTF-8 machine, from every state it reaches. -/
def utf8Lines : List String :=
  "# needed low high octet, then needed low high after it or refused: every octet from every state \
    of spec/lean/Stdx/Utf8.lean, which starts at 0 128 191. Generated by \
    spec/lean/Vectors.lean; do not edit." ::
    Utf8.State.all.flatMap fun q => octets.map (utf8Line q)

/-- A verdict of the number machine, as `number_vectors.txt` spells it. -/
def verdictText : Number.Verdict → String
  | .taken q => s!"taken {q.name}"
  | .ended => "ended"
  | .invalid => "invalid"

/-- Whether each state is whole, then every verdict of the number machine, from every state. -/
def numberLines : List String :=
  "# whole state 0|1, then accept state octet verdict [state after]: every octet from every state \
    of spec/lean/Stdx/Json/Number.lean. Generated by spec/lean/Vectors.lean; do not edit." ::
    (Number.State.all.map fun q => s!"whole {q.name} {if Number.whole q then 1 else 0}") ++
    Number.State.all.flatMap fun q =>
      octets.map fun b => s!"accept {q.name} {b} {verdictText (Number.accept q b)}"

/-- The values where an encoding changes: each length's first and last value, the surrogates'
neighbours, and the values where a continuation octet starts again. -/
def splitEdges : List Nat :=
  [0x00, 0x01, 0x3F, 0x40, 0x7F, 0x80, 0xBF, 0xC0, 0xFF, 0x100, 0x7BF, 0x7C0, 0x7FF, 0x800, 0x83F,
    0x840, 0xFFF, 0x1000, 0xCFFF, 0xD000, 0xD7FF, 0xD800, 0xDBFF, 0xDFFF, 0xE000, 0xFFFF, 0x10000,
    0x1003F, 0x10FFF, 0x3FFFF, 0x40000, 0xFFFFF, 0x100000, 0x10FFBF, 0x10FFFF]

/-- One sequence of octet ranges, as `utf8_split_vectors.txt` spells it. -/
def sequenceText (s : List (Nat × Nat)) : String :=
  " |" ++ String.join (s.map fun (lo, hi) => s!" {lo}-{hi}")

/-- A range and the sequences `Stdx.Regex.Utf8.sequences` gives for it. -/
def splitLine (lo hi : Nat) : String :=
  s!"{lo} {hi}" ++ String.join ((Stdx.Regex.Utf8.sequences lo hi).map sequenceText)

/-- The sequences of every range between two of `splitEdges`. -/
def splitLines : List String :=
  "# first last, then for each sequence a bar and its octet ranges first-last: the sequences of     spec/lean/Stdx/Regex/Utf8.lean for each range between two of 35 scalar values. Generated by     spec/lean/Vectors.lean; do not edit." ::
    splitEdges.flatMap fun lo =>
      (splitEdges.filter fun hi => lo ≤ hi).map fun hi => splitLine lo hi

/-! ## The matcher's answers

`Stdx/Regex/MatcherAnswer.lean` proves `answerOf`: the answer of a search of a program's text.
The lines below hold that answer for programs written by hand and for programs a seed draws,
each over some texts and from each offset. A Zig test builds each program, runs `Matcher.find`,
and requires the same span. -/

open Stdx.Regex.Program in
/-- An assertion, as `program.Look` names it. -/
def lookName : Look → String
  | .behindText => "behind_text"
  | .aheadText => "ahead_text"
  | .behindLine => "behind_line"
  | .aheadLine => "ahead_line"
  | .wordBoundary => "word_boundary"
  | .notWordBoundary => "not_word_boundary"

open Stdx.Regex.Program in
/-- An instruction, as `program.Kind` names it, with its fields. -/
def instLine : Inst → String
  | .range lo hi out => s!"range {lo} {hi} {out}"
  | .ranges count => s!"ranges {count}"
  | .split out arg => s!"split {out} {arg}"
  | .save slot out => s!"save {slot} {out}"
  | .look look out => s!"look {lookName look} {out}"
  | .jump out => s!"jump {out}"
  | .done => "match"
  | .fail => "fail"

/-- The next state of a generator: Knuth's MMIX step on 64 bits. -/
def nextSeed (seed : Nat) : Nat :=
  (seed * 6364136223846793005 + 1442695040888963407) % 18446744073709551616

/-- A number under `bound` from a state's high half. -/
def draw (seed bound : Nat) : Nat := seed / 4294967296 % bound

/-- The ranges a drawn instruction takes: `a`, `b`, both, a line feed, a space, the two bytes
of `é`, and any byte. -/
def drawnRanges : List (Nat × Nat) :=
  [(97, 97), (98, 98), (97, 98), (10, 10), (32, 32), (0xC3, 0xC3), (0xA9, 0xA9), (0, 255)]

open Stdx.Regex.Program in
/-- The assertions a drawn instruction holds. -/
def drawnLooks : List Look :=
  [.behindText, .aheadText, .behindLine, .aheadLine, .wordBoundary, .notWordBoundary]

/-- The bytes a drawn text holds: letters twice as often as the others. -/
def drawnBytes : List Nat := [97, 98, 97, 98, 10, 32, 0xC3, 0xA9]

open Stdx.Regex.Program in
/-- One drawn instruction of a program of `count` instructions, and the next state. Its targets
lie from 1 up to the save before `match`, so a path writes slot 0 once and slot 1 last. -/
def drawInst (seed count : Nat) : Inst × Nat :=
  let s1 := nextSeed seed
  let s2 := nextSeed s1
  let s3 := nextSeed s2
  let out := 1 + draw s2 (count - 2)
  let arg := 1 + draw s3 (count - 2)
  let inst : Inst :=
    match draw s1 10 with
    | 0 | 1 | 2 | 3 =>
      let range := drawnRanges.getD (draw s3 drawnRanges.length) (0, 255)
      .range range.1 range.2 out
    | 4 | 5 | 6 => .split out arg
    | 7 => .jump out
    | 8 => .look (drawnLooks.getD (draw s3 drawnLooks.length) .behindText) out
    | _ => .fail
  (inst, s3)

open Stdx.Regex.Program in
/-- `middle` drawn instructions, and the next state. -/
def drawInsts (count : Nat) : Nat → Nat → List Inst × Nat
  | 0, seed => ([], seed)
  | middle + 1, seed =>
    let drawn := drawInst seed count
    let rest := drawInsts count middle drawn.2
    (drawn.1 :: rest.1, rest.2)

open Stdx.Regex.Program in
/-- A drawn program of `count` instructions: a save of slot 0, drawn instructions, a save of
slot 1, and `match`. -/
def drawProgram (seed count : Nat) : Array Inst × Nat :=
  let middle := drawInsts count (count - 3) seed
  ((Inst.save 0 1 :: middle.1 ++ [Inst.save 1 (count - 1), Inst.done]).toArray, middle.2)

/-- A drawn text of `len` bytes, and the next state. -/
def drawText : Nat → Nat → List Nat × Nat
  | 0, seed => ([], seed)
  | len + 1, seed =>
    let rest := drawText len (nextSeed seed)
    (drawnBytes.getD (draw (nextSeed seed) drawnBytes.length) 97 :: rest.1, rest.2)

/-- `count` drawn texts of 0 to 6 bytes, and the next state. -/
def drawTexts : Nat → Nat → List (List Nat) × Nat
  | 0, seed => ([], seed)
  | count + 1, seed =>
    let text := drawText (draw (nextSeed seed) 7) (nextSeed seed)
    let rest := drawTexts count text.2
    (text.1 :: rest.1, rest.2)

open Stdx.Regex.Program in
/-- The programs written by hand, each a pattern's instructions between the two saves:
`a|ab`, `a*`, `a*?`, `(a*)*b`, `\ba+\b`, `(?m)^b$`, a class of two ranges before `é`, and the
empty pattern. -/
def handPrograms : List (Array Inst) :=
  [#[.save 0 1, .split 2 3, .range 97 97 5, .range 97 97 4, .range 98 98 5, .save 1 6, .done],
    #[.save 0 1, .split 2 3, .range 97 97 1, .save 1 4, .done],
    #[.save 0 1, .split 3 2, .range 97 97 1, .save 1 4, .done],
    #[.save 0 1, .split 2 5, .split 3 4, .range 97 97 2, .jump 1, .range 98 98 6, .save 1 7,
      .done],
    #[.save 0 1, .look .wordBoundary 2, .range 97 97 3, .split 2 4, .look .wordBoundary 5,
      .save 1 6, .done],
    #[.save 0 1, .look .behindLine 2, .range 98 98 3, .look .aheadLine 4, .save 1 5, .done],
    #[.save 0 1, .ranges 2, .range 10 10 4, .range 97 98 4, .range 0xC3 0xC3 5,
      .range 0xA9 0xA9 6, .save 1 7, .done],
    #[.save 0 1, .save 1 2, .done]]

/-- Whether a match may start before a byte: before any byte of a program of bytes, and before
no continuation byte of a program of UTF-8. -/
def mayStart (utf8 : Bool) (b : Nat) : Bool := !utf8 || !(0x80 ≤ b && b ≤ 0xBF)

open Stdx.Regex.Program Stdx.Regex.Matcher in
/-- The answer of one search, as `matcher_vectors.txt` spells it. -/
def findLine (utf8 : Bool) (prog : Array Inst) (text : List Nat) (low : Nat) : String :=
  match answerFast prog 0 text (Stdx.Regex.Dfa.startsOf text (mayStart utf8)) low with
  | none => s!"find {low} none"
  | some (s, e) => s!"find {low} {s} {e}"

open Stdx.Regex.Program in
/-- A text and its searches from each offset. -/
def textLines (utf8 : Bool) (prog : Array Inst) (text : List Nat) : List String :=
  (s!"text {text.length}" ++ String.join (text.map fun b => s!" {b}")) ::
    (List.range (text.length + 1)).map (findLine utf8 prog text)

open Stdx.Regex.Program in
/-- A program, its texts, and their searches. -/
def programLines (utf8 : Bool) (prog : Array Inst) (texts : List (List Nat)) : List String :=
  s!"program {if utf8 then "utf8" else "bytes"} {prog.size} 0 none" ::
    prog.toList.map instLine ++ (if Stdx.Regex.Matcher.isExact prog then [] else ["differs exact"])
      ++ texts.flatMap (textLines utf8 prog)

/-- The texts each drawn program is searched in. -/
def textsPerProgram : Nat := 8

/-- The lines of `index` drawn programs, of 4 to 10 instructions, UTF-8 and bytes in turn. -/
def drawnLines : Nat → Nat → List String
  | 0, _ => []
  | index + 1, seed =>
    let prog := drawProgram seed (4 + index % 7)
    let texts := drawTexts textsPerProgram prog.2
    programLines (index % 2 == 0) prog.1 texts.1 ++ drawnLines index texts.2

/-- The lines of the programs written by hand, each as UTF-8 and as bytes, over drawn texts. -/
def handLines : List String :=
  let texts := (drawTexts 24 20261124).1
  handPrograms.flatMap fun prog => programLines true prog texts ++ programLines false prog texts

/-- The programs a seed draws. -/
def drawnPrograms : Nat := 256

/-- The first line of a file of matcher vectors: what its lines hold. -/
def matcherHeader : String :=
  "# program utf8|bytes count forward reverse, then count instructions as program.Kind names \
    them with their fields, then text len bytes, then find low start end or find low none: the \
    answer that spec/lean/Stdx/Regex/MatcherAnswer.lean proves for each search. Generated by \
    spec/lean/Vectors.lean; do not edit."

/-- Programs, texts and the answer of each search. -/
def matcherLines : List String :=
  matcherHeader :: handLines ++ drawnLines drawnPrograms 24112026

/-- The lines of `count` programs that `seed` draws: a run of the check that
`tools/matcher_model_check.sh` makes with a new seed. -/
def randomLines (seed count : Nat) : List String :=
  s!"# seed {seed}, {count} programs." :: matcherHeader :: drawnLines count seed

/-! ## The answers of a dump

`tools/matcher_replay.zig` writes the programs that `compile` gives the patterns a seed draws,
each with its forward and its reverse entry, some texts, and a `search` line for each search.
The lines below read such a dump and write it again with each `search` line as a `find` line:
the answer `answerFast` gives, which `answerFast_isAnswer` proves.

That theorem and the two DFAs' theorems take three hypotheses: `Exact`, `Reverses` and
`EmptyElsewhere`. After each text, the lines below run the checks of
`Stdx/Regex/Hypotheses.lean` and `Stdx/Regex/Searcher.lean`, which decide them for the dump's
program and text, and write a line that begins `differs` where one fails. Where the program has
a reverse half, they also run the model's two scans for each search, and write such a line
where the scans do not give the answer.

A `claim suffix` line holds the literal that a Zig searcher took for claim R4 by its first
rule. The lines below decide that rule from the program, with `apartOn` of
`Stdx/Regex/Rules.lean`, and write such a line where it does not hold. A `claim suffix-wide`
line holds a literal that a searcher took after it read enough text, by the second rule or the
third, which `wideOn` of `Stdx/Regex/RulesSeparator.lean` decides. A `claim inner` line holds
the literal of claim R14, after the instruction where the reverse program stands after it,
and `innerOn` of `Stdx/Regex/RulesInner.lean` decides its rule.

The theorems of the claims take `StartsClean` in the place of `EmptyElsewhere`. So after a
`claim` line, the lines below decide `StartsClean` for each short text too. -/

open Stdx.Regex.Program in
/-- An assertion from the name `program.Look` gives it. -/
def lookOfName : String → Option Look
  | "behind_text" => some .behindText
  | "ahead_text" => some .aheadText
  | "behind_line" => some .behindLine
  | "ahead_line" => some .aheadLine
  | "word_boundary" => some .wordBoundary
  | "not_word_boundary" => some .notWordBoundary
  | _ => none

open Stdx.Regex.Program in
/-- An instruction from the words of its line, as `instLine` writes them. -/
def instOfWords : List String → Option Inst
  | ["range", lo, hi, out] => do pure (Inst.range (← lo.toNat?) (← hi.toNat?) (← out.toNat?))
  | ["ranges", count] => do pure (Inst.ranges (← count.toNat?))
  | ["split", out, arg] => do pure (Inst.split (← out.toNat?) (← arg.toNat?))
  | ["save", slot, out] => do pure (Inst.save (← slot.toNat?) (← out.toNat?))
  | ["look", name, out] => do pure (Inst.look (← lookOfName name) (← out.toNat?))
  | ["jump", out] => do pure (Inst.jump (← out.toNat?))
  | ["match"] => some Inst.done
  | ["fail"] => some Inst.fail
  | _ => none

/-- What the lines of a dump read so far hold: a program, its two entries, and a text. -/
structure Dump where
  /-- Whether the program reads its text as UTF-8. -/
  utf8 : Bool := true
  /-- The program's instructions, its forward half first. -/
  prog : Array Stdx.Regex.Program.Inst := #[]
  /-- Where the forward program starts. -/
  forward : Nat := 0
  /-- Where the reverse program starts, where the program has one. -/
  reverse : Option Nat := none
  /-- The text of the searches that follow. -/
  text : List Nat := []
  /-- Whether the program has a `claim` line. -/
  claimed : Bool := false

/-- The longest text whose two hypotheses the lines below decide. `reversesOn` reads each pair
of offsets, so a long text costs too much, and the answer of a search needs neither. -/
def hypothesisLenMax : Nat := 16

open Stdx.Regex.Matcher in
/-- A line that begins `differs` for each hypothesis that the dump's program and text do not
pass: `Exact` for the program, and for a text of at most `hypothesisLenMax` bytes
`EmptyElsewhere`, and `Reverses` for the program's two halves. With the three, `byDfa_answer`
proves that the forward and the reverse scan of `Stdx/Regex/Searcher.lean` give each answer
below. For a program with a `claim` line, also `StartsClean`, which the theorem of each claim
takes. -/
def hypothesisLines (dump : Dump) : List String :=
  let starts := Stdx.Regex.Dfa.startsOf dump.text (mayStart dump.utf8)
  let short := dump.text.length ≤ hypothesisLenMax
  (if isExact dump.prog then [] else ["differs exact"]) ++
    (if !short || emptyElsewhereOn dump.prog dump.forward dump.text starts then []
      else ["differs starts"])
    ++ (if !short || !dump.claimed || startsCleanOn dump.prog dump.forward dump.text starts
      then [] else ["differs starts-clean"])
    ++ match dump.reverse with
    | none => []
    | some reverse =>
      if !short || reversesOn dump.prog dump.forward dump.prog reverse dump.text then []
      else ["differs reverses"]

/-- A span as a `find` line spells it. -/
def spanWords : Option (Nat × Nat) → String
  | none => "none"
  | some (s, e) => s!"{s} {e}"

open Stdx.Regex.Matcher in
/-- The answer of one search of a dump. Where the program has a reverse half, the span comes
from `byDfa`, the forward DFA's scan and then the reverse DFA's, and `isAnswerOf` holds it to
the answer by two passes: `isAnswer_of_isAnswerOf` proves the line, for a program that is
`Exact`. Where `byDfa` does not give the answer, `answerFast` gives it, and a line that begins
`differs` follows. `byDfa_answer` proves that no such line comes where the text's hypotheses
hold. -/
def searchLines (dump : Dump) (low : Nat) : List String :=
  let starts := Stdx.Regex.Dfa.startsOf dump.text (mayStart dump.utf8)
  match dump.reverse with
  | none => [s!"find {low} {spanWords (answerFast dump.prog dump.forward dump.text starts low)}"]
  | some reverse =>
    let scanned :=
      byDfa dump.prog dump.forward dump.prog reverse dump.text (mayStart dump.utf8) low
    if isAnswerOf dump.prog dump.forward dump.text starts low scanned then
      [s!"find {low} {spanWords scanned}"]
    else
      [s!"find {low} {spanWords (answerFast dump.prog dump.forward dump.text starts low)}",
        s!"differs dfa {low} gives {spanWords scanned}"]

open Stdx.Regex.Matcher in
/-- A line that begins `differs` where claim R4's first rule does not hold for a literal that a
Zig searcher took by it. `literal` holds the bytes in the text's order. `apartOn` decides the
rule from the program, and `apart_program` proves the search from it for each text that has
the builder's hypotheses. So a literal that fails is a wrong choice for some text. -/
def claimLines (dump : Dump) (literal : List Nat) : List String :=
  match dump.reverse with
  | none => ["differs claim suffix"]
  | some reverse =>
    if (apartOn dump.prog reverse literal.reverse).isSome then [] else ["differs claim suffix"]

open Stdx.Regex.Matcher in
/-- A line that begins `differs` where neither the second rule of claim R4 nor the third holds
for a literal that a Zig searcher took after it read enough text. `wideOn` decides both from
the program, and `wide_program` proves the search from it. -/
def wideClaimLines (dump : Dump) (literal : List Nat) : List String :=
  match dump.reverse with
  | none => ["differs claim suffix-wide"]
  | some reverse =>
    if wideOn dump.prog reverse literal.reverse then [] else ["differs claim suffix-wide"]

open Stdx.Regex.Matcher in
/-- A line that begins `differs` where claim R14's rule does not hold for a literal that a Zig
searcher took by it. `before` is the reverse DFA's second entry, where the reverse program
stands after the literal. `innerOn` decides the rule from the program for a cut: the walk of
the literal from the cut stands at `before`, every match passes the cut, and one of claim R4's
rules holds for the part of a match before the literal. The rule must hold for some cut, and
`inner_program` proves the search from it. -/
def innerClaimLines (dump : Dump) (before : Option Nat) (literal : List Nat) : List String :=
  match dump.reverse, before with
  | some reverse, some before =>
    if (List.range dump.prog.size).any fun cut =>
        innerOn dump.prog reverse cut before literal.reverse then []
    else ["differs claim inner"]
  | _, _ => ["differs claim inner"]

/-- The lines that answer one line of a dump, and what the dump holds after it. A line that
holds no program, text, claim or search is written as it is. -/
def answerLine (dump : Dump) (line : String) : List String × Dump :=
  match line.splitOn " " with
  | "claim" :: "suffix" :: _ :: bytes =>
    (line :: claimLines dump (bytes.filterMap String.toNat?), { dump with claimed := true })
  | "claim" :: "suffix-wide" :: _ :: bytes =>
    (line :: wideClaimLines dump (bytes.filterMap String.toNat?), { dump with claimed := true })
  | "claim" :: "inner" :: before :: _ :: bytes =>
    (line :: innerClaimLines dump before.toNat? (bytes.filterMap String.toNat?),
      { dump with claimed := true })
  | "program" :: encoding :: _ :: forward :: reverse :: _ =>
    ([line], { dump with
      utf8 := encoding == "utf8", prog := #[], forward := forward.toNat?.getD 0,
      reverse := reverse.toNat?, claimed := false })
  | "text" :: _ :: bytes =>
    let read := { dump with text := bytes.filterMap String.toNat? }
    (line :: hypothesisLines read, read)
  | ["search", low] =>
    match low.toNat? with
    | some low => (searchLines dump low, dump)
    | none => ([s!"differs line {line}"], dump)
  | words =>
    match instOfWords words with
    | some inst => ([line], { dump with prog := dump.prog.push inst })
    | none => ([line], dump)

/-- A dump's lines with each search answered. -/
def answersLines (text : String) : Array String :=
  ((text.splitOn "\n").foldl
    (fun (state : Array String × Dump) line =>
      if line.isEmpty then state
      else
        let answered := answerLine state.2 line
        (state.1 ++ answered.1.toArray, answered.2))
    (#[], {})).1

/-- Each vector file, from the `src` directory, and its lines. -/
def files : List (String × List String) :=
  [("utf8/utf8_vectors.txt", utf8Lines), ("json/number_vectors.txt", numberLines),
    ("regex/utf8_split_vectors.txt", splitLines), ("regex/matcher_vectors.txt", matcherLines)]

/-- Writes each file, or checks each against what the machines give; 1 when one differs. With
`--random`, writes the matcher's vectors for the programs a seed draws to standard output. With
`--answers`, writes a dump of programs and searches again, each search answered. -/
def main (arguments : List String) : IO UInt32 := do
  let usage := "usage: vectors (--write | --check) <src directory> | vectors --random <seed> \
    <count> | vectors --answers <dump file>"
  if let ["--answers", path] := arguments then
    IO.println ("\n".intercalate (answersLines (← IO.FS.readFile path)).toList)
    return 0
  if let ["--random", seed, count] := arguments then
    let (some seed, some count) := (seed.toNat?, count.toNat?) | IO.eprintln usage; return 2
    IO.println ("\n".intercalate (randomLines seed count))
    return 0
  let [mode, directory] := arguments | IO.eprintln usage; return 2
  unless mode == "--write" || mode == "--check" do
    IO.eprintln usage
    return 2
  let mut status : UInt32 := 0
  for (name, lines) in files do
    let path := System.FilePath.mk directory / name
    let text := "\n".intercalate lines ++ "\n"
    if mode == "--write" then
      IO.FS.writeFile path text
    else if (← IO.FS.readFile path) != text then
      IO.eprintln s!"{path}: not what the proved machines give; run `zig build lean -- write`"
      status := 1
  return status
