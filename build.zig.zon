.{
    .name = .stdx,
    .version = "0.0.0",
    .fingerprint = 0x5479474fb6b43e04,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (decision 7). Lazy, and requested
